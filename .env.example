# Copy to .env for local development. Real environment variables win over this file.
DATABASE_URL=postgres://paxafe:paxafe@localhost:5433/paxafe
PORT=3000
LOG_LEVEL=info
# Optional: upserted at boot as the unscoped key named "seed". Use a long random value in deployed environments.
SEED_API_KEY=
# Optional: per-key request budget per minute (in-memory token bucket, per instance).
RATE_LIMIT_PER_MIN=600
# Optional: per-client-IP budget per minute, checked before auth (in memory, per instance).
RATE_LIMIT_PER_IP_PER_MIN=1200
# Optional: host port for the docker compose database (default 5433).
DB_PORT=5433
