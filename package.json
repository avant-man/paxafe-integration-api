{
  "name": "paxafe-integration-api",
  "version": "1.0.0",
  "private": true,
  "description": "Receives Tive webhook payloads, transforms them to PAXAFE sensor and location formats, and stores them in PostgreSQL.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "create-key": "tsx src/scripts/create-key.ts",
    "retention": "tsx src/scripts/retention.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "ajv": "^8.20.0",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
